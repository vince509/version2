{
  "name": "sti-alaminos-research-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Research library with persistent accounts, local or cloud file storage, and free local search.",
  "scripts": {
    "build": "node scripts/prepare-vercel-assets.js",
    "migrate:vercel-data": "node --env-file-if-exists=.env scripts/migrate-atlas-to-neon.js",
    "start": "node --env-file-if-exists=.env server.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0"
  }
}
